<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">
    <!--
    line 2: Provides a flexible, flat layout system where child views are positioned
    relative to each other or the parent.
    lines 5, 6: Sets the ConstraintLayout to fill the entire width
    and height of the screen.
    line 7: Specifies the associated activity (MainActivity) for design-time preview.
    -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <!--
        line 15: Provides a pull-to-refresh mechanism for updating content
        (e.g., the RecyclerView inside it).
        line 16: Assigns an ID (swipeRefresh) to the SwipeRefreshLayout.
        lines 19-22: Makes the SwipeRefreshLayout fill the entire parent layout.
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp"
            tools:listitem="@layout/item_group" />
        <!--
        line 29: Displays a scrollable list of items (e.g., grouped Item objects from the ViewModel).
        line 30: Assigns an ID (recyclerView) to the RecyclerView.
        line 33: Allows items to scroll fully into the padded area (e.g., under the 8dp padding).
        line 35: Specifies a layout (item_group) for previewing list items in Android Studio
        -->

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <!--
    line 46: Assigns an ID (progressBar) to the ProgressBar.
    lines 47, 48: Sets the ProgressBar size to wrap its intrinsic content (a spinning circle).
    line 49: Ensures it’s invisible until explicitly shown (e.g., during loading).
    gone removes it from the layout entirely (unlike invisible), optimizing space.
    Accessibility: Add android:contentDescription to the ProgressBar for screen readers.
    -->

</androidx.constraintlayout.widget.ConstraintLayout>
